# Hindsight Cloud: sign up at https://ui.hindsight.vectorize.io, create an API key
#   HINDSIGHT_URL=https://api.hindsight.vectorize.io
# Self-hosted (API on 8888, UI on 9999):
#   docker run -it -p 8888:8888 -p 9999:9999 -e HINDSIGHT_API_LLM_PROVIDER=groq \
#     -e HINDSIGHT_API_LLM_API_KEY=$GROQ_API_KEY -v hindsight-data:/home/hindsight/.pg0 \
#     ghcr.io/vectorize-io/hindsight:latest
#   HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
DEJA_BANK_ID=deja-oncall

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b
